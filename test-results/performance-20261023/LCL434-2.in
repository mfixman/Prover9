assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
c_in(v_pa,c_insert(v_p,v_H,tc_PropLog_Opl(t_a)),tc_PropLog_Opl(t_a)) # label(cls_conjecture_0) # label(negated_conjecture).
-c_in(c_PropLog_Opl_Oop_A_N_62(v_p,v_pa,t_a),c_PropLog_Othms(v_H,t_a),tc_PropLog_Opl(t_a)) # label(cls_conjecture_1) # label(negated_conjecture).
-c_in(V_p,V_H,tc_PropLog_Opl(T_a)) | c_in(V_p,c_PropLog_Othms(V_H,T_a),tc_PropLog_Opl(T_a)) # label(cls_PropLog_Othms_OH_0) # label(axiom).
c_in(c_PropLog_Opl_Oop_A_N_62(V_p,V_p,T_a),c_PropLog_Othms(V_H,T_a),tc_PropLog_Opl(T_a)) # label(cls_PropLog_Othms__I_0) # label(axiom).
-c_in(V_q,c_PropLog_Othms(V_H,T_a),tc_PropLog_Opl(T_a)) | c_in(c_PropLog_Opl_Oop_A_N_62(V_p,V_q,T_a),c_PropLog_Othms(V_H,T_a),tc_PropLog_Opl(T_a)) # label(cls_PropLog_Oweaken__right_0) # label(axiom).
-c_in(V_a,c_insert(V_b,V_A,T_a),T_a) | c_in(V_a,V_A,T_a) | V_a = V_b # label(cls_Set_OinsertE_0) # label(axiom).
end_of_list.

formulas(goals).
