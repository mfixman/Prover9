assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
combK != combS # label(k_s) # label(axiom).
combK != comb_app(P,Q) # label(k_app) # label(axiom).
combS != comb_app(P,Q) # label(s_app) # label(axiom).
comb_app(P1,Q1) != comb_app(P2,Q2) | P1 = P2 # label(app_app1) # label(axiom).
comb_app(P1,Q1) != comb_app(P2,Q2) | Q1 = Q2 # label(app_app2) # label(axiom).
P1 != P2 | Q1 != Q2 | comb_app(P1,Q1) = comb_app(P2,Q2) # label(app_app3) # label(axiom).
-member(comb_app(P,Q),comb) | member(P,comb) # label(ap_E1) # label(axiom).
-member(comb_app(P,Q),comb) | member(Q,comb) # label(ap_E2) # label(axiom).
member(combK,comb) # label(comb_intros1) # label(axiom).
member(combS,comb) # label(comb_intros2) # label(axiom).
-member(P,comb) | -member(Q,comb) | member(comb_app(P,Q),comb) # label(comb_intros3) # label(axiom).
-member(A,comb) | member(pair(A,A),rtrancl(contract)) # label(reduction_refl) # label(axiom).
-member(P,comb) | -member(Q,comb) | member(pair(comb_app(comb_app(combK,P),Q),P),contract) # label(contract_K) # label(axiom).
-member(P,comb) | -member(Q,comb) | -member(R,comb) | member(pair(comb_app(comb_app(comb_app(combS,P),Q),R),comb_app(comb_app(P,R),comb_app(Q,R))),contract) # label(contract_S) # label(axiom).
-member(pair(comb_app(P,Q),R),contract) | ap_contractE_c1(P,Q,R) | ap_contractE_c2(P,Q,R) | ap_contractE_c3(P,Q,R) | ap_contractE_c4(P,Q,R) # label(ap_contractE1) # label(axiom).
-ap_contractE_c1(P,Q,R) | member(R,comb) # label(ap_contractE2) # label(axiom).
-ap_contractE_c1(P,Q,R) | member(Q,comb) # label(ap_contractE3) # label(axiom).
-ap_contractE_c1(P,Q,R) | P = comb_app(combK,R) # label(ap_contractE4) # label(axiom).
-ap_contractE_c2(P,Q,R) | member(ap_contractE_sk1p(P,Q,R),comb) # label(ap_contractE5) # label(axiom).
-ap_contractE_c2(P,Q,R) | member(ap_contractE_sk1q(P,Q,R),comb) # label(ap_contractE6) # label(axiom).
-ap_contractE_c2(P,Q,R) | member(Q,comb) # label(ap_contractE7) # label(axiom).
-ap_contractE_c2(P,Q,R) | R = comb_app(comb_app(ap_contractE_sk1p(P,Q,R),Q),comb_app(ap_contractE_sk1q(P,Q,R),Q)) # label(ap_contractE8) # label(axiom).
-ap_contractE_c2(P,Q,R) | P = comb_app(comb_app(combS,ap_contractE_sk1p(P,Q,R)),ap_contractE_sk1q(P,Q,R)) # label(ap_contractE9) # label(axiom).
-ap_contractE_c3(P,Q,R) | member(pair(P,ap_contractE_sk2q(P,Q,R)),contract) # label(ap_contractE10) # label(axiom).
-ap_contractE_c3(P,Q,R) | member(Q,comb) # label(ap_contractE11) # label(axiom).
-ap_contractE_c3(P,Q,R) | R = comb_app(ap_contractE_sk2q(P,Q,R),Q) # label(ap_contractE12) # label(axiom).
-ap_contractE_c4(P,Q,R) | member(pair(Q,ap_contractE_sk3q(P,Q,R)),contract) # label(ap_contractE13) # label(axiom).
-ap_contractE_c4(P,Q,R) | member(P,comb) # label(ap_contractE14) # label(axiom).
-ap_contractE_c4(P,Q,R) | R = comb_app(P,ap_contractE_sk3q(P,Q,R)) # label(ap_contractE15) # label(axiom).
-member(pair(combK,R),contract) # label(k_contractE) # label(axiom).
-member(pair(combS,R),contract) # label(s_contractE) # label(axiom).
-member(P,comb) | member(pair(P,P),parcontract) # label(parcontract_intros1) # label(axiom).
-member(P,comb) | -member(Q,comb) | member(pair(comb_app(comb_app(combK,P),Q),P),parcontract) # label(parcontract_intros2) # label(axiom).
-member(P,comb) | -member(Q,comb) | -member(R,comb) | member(pair(comb_app(comb_app(comb_app(combS,P),Q),R),comb_app(comb_app(P,R),comb_app(Q,R))),parcontract) # label(parcontract_intros3) # label(axiom).
-member(pair(P,Q),parcontract) | -member(pair(R,S),parcontract) | member(pair(comb_app(P,R),comb_app(Q,S)),parcontract) # label(parcontract_intros4) # label(axiom).
-member(pair(combK,R),parcontract) | member(combK,comb) # label(k_parcontractE1) # label(axiom).
-member(pair(combK,R),parcontract) | R = combK # label(k_parcontractE2) # label(axiom).
-member(pair(combS,R),parcontract) | member(combS,comb) # label(s_parcontractE1) # label(axiom).
-member(pair(combS,R),parcontract) | R = combS # label(s_parcontractE2) # label(axiom).
-member(pair(comb_app(P,Q),R),parcontract) | ap_parcontractE_c1(P,Q,R) | ap_parcontractE_c2(P,Q,R) | ap_parcontractE_c3(P,Q,R) | ap_parcontractE_c4(P,Q,R) # label(ap_parcontractE1) # label(axiom).
-ap_parcontractE_c1(P,Q,R) | member(comb_app(P,Q),comb) # label(ap_parcontractE2) # label(axiom).
-ap_parcontractE_c1(P,Q,R) | R = comb_app(P,Q) # label(ap_parcontractE3) # label(axiom).
-ap_parcontractE_c2(P,Q,R) | member(R,comb) # label(ap_parcontractE4) # label(axiom).
-ap_parcontractE_c2(P,Q,R) | member(Q,comb) # label(ap_parcontractE5) # label(axiom).
-ap_parcontractE_c2(P,Q,R) | P = comb_app(combK,R) # label(ap_parcontractE6) # label(axiom).
-ap_parcontractE_c3(P,Q,R) | member(ap_parcontractE_sk1p(P,Q,R),comb) # label(ap_parcontractE7) # label(axiom).
-ap_parcontractE_c3(P,Q,R) | member(ap_parcontractE_sk1q(P,Q,R),comb) # label(ap_parcontractE8) # label(axiom).
-ap_parcontractE_c3(P,Q,R) | member(Q,comb) # label(ap_parcontractE9) # label(axiom).
-ap_parcontractE_c3(P,Q,R) | R = comb_app(comb_app(ap_parcontractE_sk1p(P,Q,R),Q),comb_app(ap_parcontractE_sk1q(P,Q,R),Q)) # label(ap_parcontractE10) # label(axiom).
-ap_parcontractE_c3(P,Q,R) | P = comb_app(comb_app(combS,ap_parcontractE_sk1p(P,Q,R)),ap_parcontractE_sk1q(P,Q,R)) # label(ap_parcontractE11) # label(axiom).
-ap_parcontractE_c4(P,Q,R) | member(pair(P,ap_parcontractE_sk2q(P,Q,R)),parcontract) # label(ap_parcontractE12) # label(axiom).
-ap_parcontractE_c4(P,Q,R) | member(pair(Q,ap_parcontractE_sk2s(P,Q,R)),parcontract) # label(ap_parcontractE13) # label(axiom).
-ap_parcontractE_c4(P,Q,R) | R = comb_app(ap_parcontractE_sk2q(P,Q,R),ap_parcontractE_sk2s(P,Q,R)) # label(ap_parcontractE14) # label(axiom).
member(pair(comb_app(comb_app(combS,p),q),r),parcontract) # label(s2_parcontractD_h1) # label(hypothesis).
r != comb_app(comb_app(combS,PP),QP) | -member(pair(p,PP),parcontract) | -member(pair(q,QP),parcontract) # label(s2_parcontractD_c1) # label(negated_conjecture).
end_of_list.

formulas(goals).
end_of_list.
