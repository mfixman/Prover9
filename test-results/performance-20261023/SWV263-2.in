assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
c_lessequals(v_G,v_H,tc_set(tc_Message_Omsg)) # label(cls_conjecture_0) # label(negated_conjecture).
c_in(v_X,v_G,tc_Message_Omsg) # label(cls_conjecture_1) # label(negated_conjecture).
-c_in(v_X,c_Message_Oparts(v_H),tc_Message_Omsg) # label(cls_conjecture_2) # label(negated_conjecture).
-c_in(V_X,V_H,tc_Message_Omsg) | c_in(V_X,c_Message_Oparts(V_H),tc_Message_Omsg) # label(cls_Message_Oparts_OInj_0) # label(axiom).
-c_in(V_c,V_A,T_a) | -c_lessequals(V_A,V_B,tc_set(T_a)) | c_in(V_c,V_B,T_a) # label(cls_Set_OsubsetD_0) # label(axiom).
end_of_list.

formulas(goals).
end_of_list.
