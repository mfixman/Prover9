assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
p2(X3,X3) # label(p2_1) # label(negated_conjecture).
p4(X19,X19) # label(p4_2) # label(negated_conjecture).
-p2(c6,f3(c8,f5(c9))) # label(not_p2_3) # label(negated_conjecture).
p2(f3(X10,X11),f3(X11,X10)) # label(p2_4) # label(negated_conjecture).
p2(f5(X15),f5(X16)) | -p4(X15,X16) # label(p2_5) # label(negated_conjecture).
p2(X4,X5) | -p2(X3,X4) | -p2(X3,X5) # label(p2_6) # label(negated_conjecture).
p4(X17,X18) | -p4(X19,X17) | -p4(X19,X18) # label(p4_7) # label(negated_conjecture).
p2(X0,X1) | -p2(f3(X0,X2),f3(X1,X2)) # label(p2_8) # label(negated_conjecture).
p2(f3(X0,X2),f3(X1,X2)) | -p2(X0,X1) # label(p2_9) # label(negated_conjecture).
p2(f3(X12,f3(X13,X14)),f3(X13,f3(X12,X14))) # label(p2_10) # label(negated_conjecture).
p2(f3(f3(X12,X13),X14),f3(X12,f3(X13,X14))) # label(p2_11) # label(negated_conjecture).
p2(f3(c6,f5(c7)),f3(c8,f3(f5(c7),f5(c9)))) # label(p2_12) # label(negated_conjecture).
p2(f3(X6,X7),f3(X8,X9)) | -p2(X6,X8) | -p2(X7,X9) # label(p2_13) # label(negated_conjecture).
end_of_list.

formulas(goals).
end_of_list.
