assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
divide(divide(X,divide(Y,Z)),divide(X,Y)) = Z # label(single_axiom) # label(axiom).
multiply(X,Y) = divide(X,divide(divide(Z,Z),Y)) # label(multiply) # label(axiom).
inverse(X) = divide(divide(Z,Z),X) # label(inverse) # label(axiom).
multiply(inverse(a1),a1) != multiply(inverse(b1),b1) | multiply(multiply(inverse(b2),b2),a2) != a2 | multiply(multiply(a3,b3),c3) != multiply(a3,multiply(b3,c3)) | multiply(a4,b4) != multiply(b4,a4) # label(prove_these_axioms) # label(negated_conjecture).
end_of_list.

formulas(goals).
end_of_list.
