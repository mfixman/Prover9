assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
le(A,A) # label(sos_01) # label(axiom).
-le(max(A,B),C) | le(A,C) # label(sos_02) # label(axiom).
-le(max(A,B),C) | le(B,C) # label(sos_03) # label(axiom).
eq(f(A),a0) | eq(f(A),a1) | eq(f(A),a2) # label(sos_04) # label(axiom).
-eq(f(A0),a0) | -eq(f(A1),a0) | -le(s(A0),A1) # label(sos_05) # label(axiom).
-eq(f(A0),a1) | -eq(f(A1),a1) | -le(s(A0),A1) # label(sos_06) # label(axiom).
-eq(f(A0),a2) | -eq(f(A1),a2) | -le(s(A0),A1) # label(sos_07) # label(axiom).
end_of_list.

formulas(goals).
end_of_list.
