assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
-is_a_theorem(implies(X,Y)) | -is_a_theorem(X) | is_a_theorem(Y) # label(condensed_detachment) # label(axiom).
is_a_theorem(implies(implies(X,Y),implies(implies(Y,Z),implies(X,Z)))) # label(cn_1) # label(axiom).
is_a_theorem(implies(implies(not(X),X),X)) # label(cn_2) # label(axiom).
is_a_theorem(implies(X,implies(not(X),Y))) # label(cn_3) # label(axiom).
-is_a_theorem(implies(implies(x,implies(y,z)),implies(implies(u,y),implies(x,implies(u,z))))) # label(prove_cn_05) # label(negated_conjecture).
end_of_list.

formulas(goals).
end_of_list.
