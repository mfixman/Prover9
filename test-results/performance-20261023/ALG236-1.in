assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
mult(A,mult(B,mult(A,B))) = mult(A,B) # label(c01) # label(axiom).
mult(A,mult(B,mult(C,D))) = mult(C,mult(B,mult(A,D))) # label(c02) # label(axiom).
mult(mult(A,mult(B,mult(C,B))),D) = mult(A,mult(D,mult(mult(C,B),D))) # label(c03) # label(axiom).
mult(mult(a,b),mult(c,mult(d,e))) != mult(a,mult(c,mult(mult(d,b),e))) # label(goals) # label(negated_conjecture).
end_of_list.

formulas(goals).
end_of_list.
