assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
meet(X,Y) = meet(Y,X) # label(commutativity) # label(axiom).
meet(X,meet(Y,Z)) = meet(meet(X,Y),Z) # label(associativity) # label(axiom).
join(X,Y) = join(Y,X) # label(commutativity_001) # label(axiom).
join(X,join(Y,Z)) = join(join(X,Y),Z) # label(associativity_002) # label(axiom).
join(X,meet(X,Y)) = X # label(absorption) # label(axiom).
meet(X,join(X,Y)) = X # label(absorption_003) # label(axiom).
upme(X,Y,Z) = meet(X,join(Y,Z)) # label(definition_of_upme) # label(axiom).
lome(X,Y,Z) = join(meet(X,Y),meet(X,Z)) # label(definition_of_lome) # label(axiom).
join(upme(meet(a,X1),Y1,Z1),meet(Y1,Z1)) = meet(join(meet(meet(a,X1),Y1),Z1),join(meet(meet(a,X1),Z1),Y1)) # label(rh1) # label(axiom).
upme(X,Y,Z) = join(upme(X,Y,meet(a,Z)),upme(X,Z,meet(a,Y))) # label(rh2) # label(axiom).
lome(X,Y,Z) = upme(X,upme(Y,X,Z),upme(Z,X,Y)) # label(rl1) # label(axiom).
upme(a,x2,y2) = upme(a,x2,z2) # label(conjecture) # label(negated_conjecture).
upme(x2,y2,z2) != lome(x2,y2,z2) # label(conjecture_1) # label(negated_conjecture).
end_of_list.

formulas(goals).
end_of_list.
