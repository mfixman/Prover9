assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
double_divide(double_divide(identity,A),double_divide(double_divide(double_divide(B,C),double_divide(identity,identity)),double_divide(A,C))) = B # label(single_axiom) # label(axiom).
multiply(A,B) = double_divide(double_divide(B,A),identity) # label(multiply) # label(axiom).
inverse(A) = double_divide(A,identity) # label(inverse) # label(axiom).
identity = double_divide(A,inverse(A)) # label(identity) # label(axiom).
multiply(multiply(a3,b3),c3) != multiply(a3,multiply(b3,c3)) # label(prove_these_axioms_3) # label(negated_conjecture).
end_of_list.

formulas(goals).
end_of_list.
