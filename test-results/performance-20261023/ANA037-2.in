-class_Ring__and__Field_Oordered__idom(T) | class_Orderings_Olinorder(T) # label(clsrel_Ring__and__Field_Oordered__idom_33) # label(axiom).
-class_Ring__and__Field_Oordered__idom(T) | class_Ring__and__Field_Opordered__semiring(T) # label(clsrel_Ring__and__Field_Oordered__idom_42) # label(axiom).
-class_Ring__and__Field_Oordered__idom(T) | class_Orderings_Oorder(T) # label(clsrel_Ring__and__Field_Oordered__idom_44) # label(axiom).
end_of_list.

