class_Ring__and__Field_Oordered__idom(t_b) # label(tfree_tcs) # label(negated_conjecture).
-class_Orderings_Olinorder(T_b) | c_lessequals(V_x,c_Orderings_Omax(V_x,V_y,T_b),T_b) # label(cls_Orderings_Ole__maxI1_0) # label(axiom).
-class_Orderings_Oorder(T_a) | -c_lessequals(V_y,V_z,T_a) | -c_lessequals(V_x,V_y,T_a) | c_lessequals(V_x,V_z,T_a) # label(cls_Orderings_Oorder__class_Oorder__trans_0) # label(axiom).
