assign(max_seconds,20).
assign(max_megs,256).
clear(print_given).
clear(print_initial_clauses).
clear(print_kept).
set(prolog_style_variables).

formulas(assumptions).
apply(apply(apply(b,X),Y),Z) = apply(X,apply(Y,Z)) # label(b_definition) # label(axiom).
apply(apply(w1,X),Y) = apply(apply(Y,X),X) # label(w1_definition) # label(axiom).
strong_fixed_point = apply(apply(b,apply(apply(b,apply(w1,w1)),apply(apply(b,apply(b,w1)),b))),b) # label(strong_fixed_point) # label(axiom).
apply(strong_fixed_point,fixed_pt) != apply(fixed_pt,apply(strong_fixed_point,fixed_pt)) # label(prove_strong_fixed_point) # label(negated_conjecture).
end_of_list.

formulas(goals).
end_of_list.
