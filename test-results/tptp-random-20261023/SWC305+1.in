end_of_list.

formulas(goals).
(all U (ssList(U) -> (all V (ssList(V) -> (all W (ssList(W) -> (all X (ssList(X) -> V != X | U != W | -frontsegP(X,W) | -strictorderedP(W) | (exists Y (ssList(Y) & neq(W,Y) & frontsegP(X,Y) & segmentP(Y,W) & strictorderedP(Y))) | (all Z (ssItem(Z) -> (all X1 (ssItem(X1) -> (all X2 (ssList(X2) -> (all X3 (ssList(X3) -> (all X4 (ssList(X4) -> app(app(app(app(X2,cons(Z,nil)),X3),cons(X1,nil)),X4) != U | -lt(X1,Z))))))))))))))))))) # label(co1) # label(conjecture).
end_of_list.
