set(prolog_style_variables).

formulas(assumptions).
(all A all B (r2_hidden(A,B) -> -r2_hidden(B,A))) # label(antisymmetry_r2_hidden) # label(axiom).
$T # label(t1_tarski) # label(axiom).
(all A all B ((all C (r2_hidden(C,A) <-> r2_hidden(C,B))) -> A = B)) # label(t2_tarski) # label(axiom).
(all A all B (B = k1_tarski(A) <-> (all C (r2_hidden(C,B) <-> C = A)))) # label(d1_tarski) # label(axiom).
(all A all B all C (C = k2_tarski(A,B) <-> (all D (r2_hidden(D,C) <-> D = A | D = B)))) # label(d2_tarski) # label(axiom).
$T # label(t3_tarski) # label(axiom).
$T # label(t4_tarski) # label(axiom).
(all A all B (r1_tarski(A,B) <-> (all C (r2_hidden(C,A) -> r2_hidden(C,B))))) # label(d3_tarski) # label(axiom).
