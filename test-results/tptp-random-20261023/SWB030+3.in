assign(max_seconds, 10).
assign(max_megs, 256).

% Including file Axioms/SWB002+0.ax

set(prolog_style_variables).

formulas(assumptions).
(all Z all C (iext(uri_owl_complementOf,Z,C) -> ic(Z) & ic(C) & (all X (icext(Z,X) <-> -icext(C,X))))) # label(owl_bool_complementof_class) # label(axiom).
(all Z (iext(uri_owl_intersectionOf,Z,uri_rdf_nil) <-> ic(Z) & (all X (icext(Z,X) <-> ir(X))))) # label(owl_bool_intersectionof_class_000) # label(axiom).
(all Z all S1 all C1 (iext(uri_rdf_first,S1,C1) & iext(uri_rdf_rest,S1,uri_rdf_nil) -> (iext(uri_owl_intersectionOf,Z,S1) <-> ic(Z) & ic(C1) & (all X (icext(Z,X) <-> icext(C1,X)))))) # label(owl_bool_intersectionof_class_001) # label(axiom).
(all Z all S1 all C1 all S2 all C2 (iext(uri_rdf_first,S1,C1) & iext(uri_rdf_rest,S1,S2) & iext(uri_rdf_first,S2,C2) & iext(uri_rdf_rest,S2,uri_rdf_nil) -> (iext(uri_owl_intersectionOf,Z,S1) <-> ic(Z) & ic(C1) & ic(C2) & (all X (icext(Z,X) <-> icext(C1,X) & icext(C2,X)))))) # label(owl_bool_intersectionof_class_002) # label(axiom).
(all Z all S1 all C1 all S2 all C2 all S3 all C3 (iext(uri_rdf_first,S1,C1) & iext(uri_rdf_rest,S1,S2) & iext(uri_rdf_first,S2,C2) & iext(uri_rdf_rest,S2,S3) & iext(uri_rdf_first,S3,C3) & iext(uri_rdf_rest,S3,uri_rdf_nil) -> (iext(uri_owl_intersectionOf,Z,S1) <-> ic(Z) & ic(C1) & ic(C2) & ic(C3) & (all X (icext(Z,X) <-> icext(C1,X) & icext(C2,X) & icext(C3,X)))))) # label(owl_bool_intersectionof_class_003) # label(axiom).
(all Z (iext(uri_owl_unionOf,Z,uri_rdf_nil) <-> ic(Z) & (all X -icext(Z,X)))) # label(owl_bool_unionof_class_000) # label(axiom).
(all Z all S1 all C1 (iext(uri_rdf_first,S1,C1) & iext(uri_rdf_rest,S1,uri_rdf_nil) -> (iext(uri_owl_unionOf,Z,S1) <-> ic(Z) & ic(C1) & (all X (icext(Z,X) <-> icext(C1,X)))))) # label(owl_bool_unionof_class_001) # label(axiom).
(all Z all S1 all C1 all S2 all C2 (iext(uri_rdf_first,S1,C1) & iext(uri_rdf_rest,S1,S2) & iext(uri_rdf_first,S2,C2) & iext(uri_rdf_rest,S2,uri_rdf_nil) -> (iext(uri_owl_unionOf,Z,S1) <-> ic(Z) & ic(C1) & ic(C2) & (all X (icext(Z,X) <-> icext(C1,X) | icext(C2,X)))))) # label(owl_bool_unionof_class_002) # label(axiom).
(all Z all S1 all C1 all S2 all C2 all S3 all C3 (iext(uri_rdf_first,S1,C1) & iext(uri_rdf_rest,S1,S2) & iext(uri_rdf_first,S2,C2) & iext(uri_rdf_rest,S2,S3) & iext(uri_rdf_first,S3,C3) & iext(uri_rdf_rest,S3,uri_rdf_nil) -> (iext(uri_owl_unionOf,Z,S1) <-> ic(Z) & ic(C1) & ic(C2) & ic(C3) & (all X (icext(Z,X) <-> icext(C1,X) | icext(C2,X) | icext(C3,X)))))) # label(owl_bool_unionof_class_003) # label(axiom).
(all X -icext(uri_owl_Nothing,X)) # label(owl_class_nothing_ext) # label(axiom).
ic(uri_owl_Nothing) # label(owl_class_nothing_type) # label(axiom).
(all X (icext(uri_owl_Thing,X) <-> ir(X))) # label(owl_class_thing_ext) # label(axiom).
