ip(uri_owl_allValuesFrom) # label(owl_prop_allvaluesfrom_type) # label(axiom).
(all X all Y (iext(uri_owl_complementOf,X,Y) -> ic(X) & ic(Y))) # label(owl_prop_complementof_ext) # label(axiom).
