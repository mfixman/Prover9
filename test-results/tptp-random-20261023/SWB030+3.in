(all P all C (iext(uri_rdfs_domain,P,C) <-> ip(P) & ic(C) & (all X all Y (iext(P,X,Y) -> icext(C,X))))) # label(owl_rdfsext_domain) # label(axiom).
(all P all C (iext(uri_rdfs_range,P,C) <-> ip(P) & ip(C) & (all X all Y (iext(P,X,Y) -> icext(C,Y))))) # label(owl_rdfsext_range) # label(axiom).
