(all Z all P all C (iext(uri_owl_allValuesFrom,Z,C) & iext(uri_owl_onProperty,Z,P) -> (all X (icext(Z,X) <-> (all Y (iext(P,X,Y) -> icext(C,Y))))))) # label(owl_restrict_allvaluesfrom) # label(axiom).
(all Z all P all A (iext(uri_owl_hasValue,Z,A) & iext(uri_owl_onProperty,Z,P) -> (all X (icext(Z,X) <-> iext(P,X,A))))) # label(owl_restrict_hasvalue) # label(axiom).
